{
	"expo": {
		"name": "Skriuw",
		"slug": "skriuw",
		"version": "0.2.0",
		"orientation": "portrait",
		"icon": "../desktop/src-tauri/icons/ios/AppIcon-512@2x.png",
		"scheme": "skriuw",
		"userInterfaceStyle": "automatic",
		"newArchEnabled": true,
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.skriuw.app",
			"associatedDomains": ["webcredentials:skriuw.com"],
			"icon": "../desktop/src-tauri/icons/ios/AppIcon-512@2x.png",
			"infoPlist": {
				"ITSAppUsesNonExemptEncryption": false
			}
		},
		"android": {
			"package": "com.skriuw.app",
			"versionCode": 2,
			"adaptiveIcon": {
				"foregroundImage": "../desktop/src-tauri/icons/android/mipmap-xxxhdpi/ic_launcher_foreground.png",
				"backgroundColor": "#111111"
			},
			"permissions": ["android.permission.READ_CALENDAR", "android.permission.WRITE_CALENDAR"]
		},
		"plugins": [
			"expo-router",
			"expo-secure-store",
			[
				"expo-calendar",
				{
					"calendarPermission": "Allow Skriuw to create and keep your journal entries up to date in Apple Calendar.",
					"remindersPermission": false
				}
			],
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#111111",
					"image": "../desktop/src-tauri/icons/ios/AppIcon-512@2x.png",
					"imageWidth": 112,
					"resizeMode": "contain"
				}
			]
		],
		"experiments": {
			"typedRoutes": true
		},
		"extra": {
			"apiBaseUrl": "https://skriuw.com",
			"nativePasskeysEnabled": false,
			"router": {},
			"eas": {
				"projectId": "cf3b8939-0f17-4f6f-969a-313c48900b56"
			}
		},
		"owner": "remcostoeten"
	}
}

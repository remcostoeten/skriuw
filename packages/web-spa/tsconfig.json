{
	"compilerOptions": {
		"target": "ES2023",
		"useDefineForClassFields": true,
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["vite/client", "bun", "react", "react-dom"],
		"noUncheckedSideEffectImports": false,
		"paths": {
			"@/core/workspace-backend/server-backend": ["./src/shims/server-stub-backend.ts"],
			"@/generated/*": ["../../generated/*"],
			"@/*": ["../../apps/web/src/*"]
		}
	},
	"include": ["src", "vite.config.ts"]
}

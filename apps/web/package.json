{
	"name": "@skriuw/web",
	"version": "0.22.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "env -u NODE_ENV bun --env-file=../../.env --bun next dev --turbopack",
		"prebuild": "bun run test:unit",
		"build": "env -u NODE_ENV bun --env-file=../../.env --bun next build",
		"start": "bun --env-file=../../.env --bun next start",
		"test:unit": "bun scripts/run-unit-tests.ts",
		"test:unit:isolate": "bun test --isolate __tests__",
		"test:unit:coverage": "bun test --coverage --isolate __tests__",
		"test:unit:core": "bun test __tests__/domain/journal/mappers.test.ts __tests__/domain/notes/mappers.test.ts __tests__/core/auth/index.test.ts __tests__/features/ai/provider-keys.test.ts __tests__/features/ai/usage.test.ts",
		"test:unit:web-state": "bun test __tests__/features/settings/store.test.ts __tests__/features/notes/components/sidebar/store.test.ts",
		"test:unit:bootstrap": "bun test __tests__/providers/persistence-bootstrap.test.tsx",
		"test:unit:stores": "bun test __tests__/features/notes/store.test.ts && bun test __tests__/features/journal/store.test.ts",
		"test:smoke": "bun run build && playwright test",
		"test:skeleton": "bun run build && playwright test __tests__/e2e/skeleton-qa.e2e.ts --project=chromium"
	},
	"dependencies": {
		"@animateicons/react": "^0.3.4",
		"@aws-sdk/client-s3": "^3.1081.0",
		"@better-auth/expo": "^1.6.11",
		"@excalidraw/excalidraw": "^0.18.1",
		"@vercel/blob": "^2.5.0",
		"@xyflow/react": "^12.11.2",
		"html-to-image": "^1.11.13",
		"mermaid": "^11.16.0",
		"posthog-js": "^1.399.2",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"prosemirror-model": "1.25.4"
	},
	"reactDoctor": {
		"ignore": {
			"overrides": [
				{
					"files": [
						"package.json"
					],
					"rules": [
						"deslop/unused-dependency",
						"deslop/unused-dev-dependency"
					]
				}
			]
		}
	}
}

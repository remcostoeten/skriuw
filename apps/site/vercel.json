{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": "nextjs",
	"bunVersion": "1.3.14",
	"installCommand": "bun install --frozen-lockfile",
	"buildCommand": "bash ../../tools/scripts/vercel-build.sh",
	"redirects": [
		{
			"source": "/:path*",
			"has": [
				{
					"type": "host",
					"value": "skriuw.vercel.app"
				}
			],
			"destination": "https://skriuw.com/:path*",
			"permanent": true
		},
		{
			"source": "/:path*",
			"has": [
				{
					"type": "host",
					"value": "www.skriuw.com"
				}
			],
			"destination": "https://skriuw.com/:path*",
			"permanent": true
		},
		{
			"source": "/:path*",
			"has": [
				{
					"type": "host",
					"value": "docs.skriuw.com"
				}
			],
			"destination": "https://skriuw.com/docs/",
			"permanent": true
		},
		{
			"source": "/app",
			"destination": "/app/",
			"permanent": true
		}
	],
	"headers": [
		{
			"source": "/(.*)",
			"has": [
				{
					"type": "host",
					"value": "skriuw.vercel.app"
				}
			],
			"headers": [
				{
					"key": "X-Robots-Tag",
					"value": "noindex"
				}
			]
		},
		{
			"source": "/_next/static/:asset*",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/app/assets/:asset*",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/app/sw.js",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "no-cache"
				}
			]
		}
	]
}

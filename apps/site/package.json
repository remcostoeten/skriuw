{
  "name": "skriuw-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "gen:docs": "bun scripts/generate-doc-sources.ts",
    "predev": "bun run gen:docs",
    "dev": "next dev --port 5182",
    "prebuild": "bun run gen:docs",
    "build": "next build",
    "pretypecheck": "bun run gen:docs",
    "typecheck": "tsc --noEmit",
    "start": "next start --port 5182",

    "next": "16.3.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "semver": "^7.8.5",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-beta.28",
    "tailwindcss": "^4.3.3",

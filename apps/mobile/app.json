{
	"expo": {
		"name": "Skriuw",
		"slug": "skriuw",
		"version": "0.2.0",
		"orientation": "portrait",
		"icon": "../desktop/src-tauri/icons/ios/AppIcon-512@2x.png",
		"scheme": "skriuw",
		"userInterfaceStyle": "automatic",
		"newArchEnabled": true,
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.skriuw.app",
			"icon": "../desktop/src-tauri/icons/ios/AppIcon-512@2x.png"
		},
		"android": {
			"package": "com.skriuw.app",
			"versionCode": 2,
			"adaptiveIcon": {
				"foregroundImage": "../desktop/src-tauri/icons/android/mipmap-xxxhdpi/ic_launcher_foreground.png",
				"backgroundColor": "#111111"
			}
		},
		"plugins": [
			"expo-router",
			"expo-secure-store",
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#111111",
					"image": "../desktop/src-tauri/icons/ios/AppIcon-512@2x.png",
					"imageWidth": 112,
					"resizeMode": "contain"
				}
			]
		],
		"experiments": {
			"typedRoutes": true
		},
		"extra": {
			"apiBaseUrl": "https://skriuw.com"
		}
	}
}

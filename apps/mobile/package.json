{
  "name": "skriuw-mobile",
  "private": true,
  "version": "0.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "editor:page": "bun --cwd=../workspace run build:mobile-editor",
    "export:android": "bun run editor:page && expo export --platform android",
    "export:ios": "bun run editor:page && expo export --platform ios",
    "typecheck": "find . -name tsconfig.json -not -path './node_modules/*' -not -path './.expo/*' | sort | xargs -n1 tsc --noEmit --project && tsc --noEmit --project ../../__tests__/apps/mobile",
    "test": "bun --cwd=../.. vitest run --project mobile --project theme --project icons",
    "eas-build-pre-install": "bash modules/skriuw-core/scripts/eas-build-pre-install.sh",
    "eas-build-post-install": "bun run editor:page"
  },
  "dependencies": {
    "@skriuw/icons": "workspace:*",
    "@skriuw/renderer-core": "workspace:*",
    "@skriuw/shared": "workspace:*",
    "@skriuw/theme": "workspace:*",
    "expo": "^58.0.0",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.15",
    "expo-local-authentication": "~58.0.2",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.14",
    "typescript": "~6.0.3"
  }
}

{
	"name": "@skriuw/extension",
	"version": "0.1.0",
	"private": true,
	"description": "Skriuw Web Clipper — save pages, articles and selections to Skriuw",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"zip": "bun run build && cd dist && zip -r ../skriuw-extension-v$(node -p \"require('../package.json').version\").zip . && cd ..",
		"package": "bun run zip"
	},
	"dependencies": {
		"@mozilla/readability": "^0.5.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"turndown": "^7.2.0",
		"turndown-plugin-gfm": "^1.0.2"
	},
	"devDependencies": {
		"@crxjs/vite-plugin": "^2.0.0-beta.28",
		"@types/chrome": "^0.0.287",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@types/turndown": "^5.0.5",
		"@vitejs/plugin-react": "^4.3.4",
		"typescript": "^5.7.0",
		"vite": "^6.0.0"
	}
}

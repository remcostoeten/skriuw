{
  "name": "skriuw-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bash ../../tools/scripts/dev-with-cloud.sh",
    "dev:vite": "vite",
    "build": "../../bin/build browser",
    "build:frontend": "tsc --noEmit && vite build",
    "test": "tsx scripts/test-verdict.ts",
    "e2e": "node e2e/run.mjs",
    "e2e:browser-storage": "node e2e/browser-storage.mjs",
    "e2e:browser-reset": "node e2e/browser-reset.mjs",
    "e2e:browser-account-switch": "node e2e/browser-account-switch.mjs",
    "e2e:browser-storage:firefox": "node e2e/browser-storage-firefox.mjs",
    "e2e:browser-scale": "node e2e/browser-scale.mjs",
    "e2e:mobile": "node e2e/mobile-shell.mjs",
    "e2e:native": "node e2e/run-native.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit --project ../../__tests__/support",
    "tauri": "../../tools/scripts/tauri.sh",
    "tauri:cli": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "../../bin/build desktop",
    "tauri:build:raw": "NO_STRIP=1 tauri build",
    "tauri:build:appimage": "NO_STRIP=1 tauri build --bundles appimage --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}' && exec src-tauri/target/release/bundle/appimage/Skriuw_*.AppImage"
  },
  "dependencies": {
    "@better-auth/infra": "0.4.1",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@lezer/highlight": "1.2.3",
    "@paper-design/shaders": "^0.0.80",
    "@radix-ui/react-context-menu": "^2.3.4",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.0",
    "@remcostoeten/auth-drawer": "0.4.0",
    "@remcostoeten/notifier": "1.1.0",
    "@remcostoeten/use-shortcut": "^2.4.1",
    "@replit/codemirror-vim": "6.4.0",
    "@skriuw/icons": "workspace:*",
    "@skriuw/renderer-core": "workspace:*",
    "@skriuw/theme": "workspace:*",
    "@tanstack/react-virtual": "^3.14.8",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@vercel/beautiful-mermaid": "0.1.5",
    "better-auth": "1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "motion": "^12.42.2",
    "prosemirror-commands": "1.7.1",
    "prosemirror-dropcursor": "^1.8.3",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "1.5.0",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "1.13.5",
    "prosemirror-model": "1.25.11",
    "prosemirror-schema-basic": "1.2.4",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "1.12.0",
    "prosemirror-view": "1.42.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "yaml": "^2.8.1",
    "@skriuw/shared": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.9.6",
    "@types/node": "26.1.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "tailwindcss": "^4.3.3",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}

{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Skriuw",
	"version": "0.1.0",
	"identifier": "nl.remcostoeten.skriuw.dev",
	"build": {
		"frontendDist": "../../../packages/web-spa/dist",
		"devUrl": "http://localhost:1421",
		"beforeDevCommand": "bun run --cwd ../../packages/web-spa dev",
		"beforeBuildCommand": "bun run --cwd ../../packages/web-spa build"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "main",
				"title": "Skriuw",
				"width": 1100,
				"height": 760,
				"minWidth": 720,
				"minHeight": 480,
				"resizable": true
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost https://fonts.googleapis.com https://fonts.gstatic.com https: wss:"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}

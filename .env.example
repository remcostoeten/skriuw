# -----------------------------------------------------------------------------
# DATABASE (Neon Postgres via Vercel Marketplace)
# -----------------------------------------------------------------------------
# Used by Prisma (prisma.config.ts) and the PrismaPg driver adapter (src/lib/prisma.ts).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# -----------------------------------------------------------------------------
# AUTH (Better Auth)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="generate-a-32-char-min-secret"
# Server-side base URL. Used for trustedOrigins CSRF check.
BETTER_AUTH_URL="http://localhost:3000"
# Client-side base URL. Read by createAuthClient in src/lib/auth-client.ts.
# Set both to the same value in production (e.g. https://skriuw.app).
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Optional: GitHub OAuth (omit both to hide the GitHub sign-in button).
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# DEMO GUEST (optional — full app without sign-up, for previews / external AI)
# -----------------------------------------------------------------------------
# When true, unauthenticated /app visits auto sign in as a shared demo user.
# Run `bun run demo-guest:ensure` once after enabling. Do not enable on production
# unless you intend a public writable sandbox.
SKRIUW_DEMO_GUEST_MODE=""
SKRIUW_DEMO_GUEST_EMAIL="guest@demo.skriuw.local"
SKRIUW_DEMO_GUEST_PASSWORD="demo-guest-skriuw"
SKRIUW_DEMO_GUEST_NAME="Guest demo"

# -----------------------------------------------------------------------------
# AI
# -----------------------------------------------------------------------------
# Required to encrypt user-supplied provider keys at rest (AES). Min 32 chars.
AI_KEYS_ENCRYPTION_SECRET="your-ai-provider-key-encryption-secret"
# Optional server-side fallback keys (used when a user has no saved key).
# GEMINI_API_KEY is the Google Generative AI key (kept as GEMINI_* for backcompat).
GEMINI_API_KEY=""
GROQ_API_KEY=""

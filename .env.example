# -----------------------------------------------------------------------------
# DATABASE (Neon Postgres via Vercel Marketplace)
# -----------------------------------------------------------------------------
# Used by Prisma (prisma.config.ts) and the PrismaPg driver adapter (src/lib/prisma.ts).
# Use sslmode=verify-full for Neon/managed Postgres (pg v9 will treat require differently).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# -----------------------------------------------------------------------------
# AUTH (Better Auth)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="generate-a-32-char-min-secret"
# Server-side base URL. Used for trustedOrigins CSRF check.
# REQUIRED in production/self-host: if unset, auth falls back to the
# maintainer's own domain (https://skriuw.com) — auth will silently break.
BETTER_AUTH_URL="http://localhost:3000"
# Client-side base URL. Read by createAuthClient in src/lib/auth-client.ts.
# Set both to the same value in production (e.g. https://your-domain.com).
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
# Optional native passkey origins. Add Android values in the form
# android:apk-key-hash:<base64-sha256> once a signing certificate exists.
PASSKEY_NATIVE_ORIGINS=""

# Optional: GitHub OAuth (omit both to hide the GitHub sign-in button).
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Optional: Google OAuth.
# Authorized redirect URI: https://skriuw.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# AI
# -----------------------------------------------------------------------------
# Required to encrypt user-supplied provider keys at rest (AES). Min 32 chars.
AI_KEYS_ENCRYPTION_SECRET="your-ai-provider-key-encryption-secret"
# Optional server-side fallback keys (used when a user has no saved key).
# GEMINI_API_KEY is the Google Generative AI key (kept as GEMINI_* for backcompat).
GEMINI_API_KEY=""
GROQ_API_KEY=""

# -----------------------------------------------------------------------------
# ANALYTICS (Remco Analytics — self-hosted)
# -----------------------------------------------------------------------------
# Browser SDK ingest base URL (posts to {url}/e).
NEXT_PUBLIC_ANALYTICS_URL="https://ingestion.remcostoeten.nl"
# Set to "false" to disable client analytics entirely.
NEXT_PUBLIC_ANALYTICS_ENABLED="true"
# Server-side ingest (trackServerEvent). Same base URL, no NEXT_PUBLIC_ prefix.
ANALYTICS_URL="https://ingestion.remcostoeten.nl"
# Bearer token — must match INGEST_SECRET on the ingestion service.
# Required for server-side auth events; client pageviews use origin allowlist only.
INGEST_SECRET="generate-with-openssl-rand-base64-32"

# -----------------------------------------------------------------------------
# POSTHOG
# -----------------------------------------------------------------------------
# Runs alongside Remco Analytics. Leave the key empty to disable PostHog
# entirely — nothing loads and no events are sent.
# The browser posts to the same-origin /ph-ingest rewrite, not to us.i.posthog.com.
NEXT_PUBLIC_POSTHOG_KEY=""
# Only used to build "view in PostHog" links; not an ingest endpoint.
NEXT_PUBLIC_POSTHOG_UI_HOST="https://us.posthog.com"

# -----------------------------------------------------------------------------
# REAL-TIME COLLABORATION (Yjs over a Cloudflare Workers PartyServer)
# -----------------------------------------------------------------------------
# The realtime backend is the Worker in party/notes.ts (config: wrangler.jsonc),
# NOT partykit.dev. Run it locally with `bun run party:dev` (serves :8787) and
# deploy it with `bun run party:deploy`.
#
# Shared HMAC secret signing room tokens. The Next app signs tokens with it and
# the Worker verifies them in onBeforeConnect — they MUST match or every socket
# 401s and nothing syncs. Generate: openssl rand -base64 32
#   - Local worker:  put this value in `.dev.vars` (gitignored), same key.
#   - Prod worker:   `bunx wrangler secret put COLLAB_AUTH_SECRET` (same value).
COLLAB_AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Host the browser opens the Yjs WebSocket to. LEAVE BLANK to disable realtime
# collaboration — the correct default for Docker/self-host, since the collab
# backend is a Cloudflare Worker (party/) that is NOT part of the Docker stack.
# A non-empty value here enables collab; pointing it at a worker that isn't
# running makes every socket 401. Only set this if you deployed the worker.
#   - Local dev:   127.0.0.1:8787  (wrangler dev default; matches `bun run party:dev`)
#   - Production:  <worker-name>.<subdomain>.workers.dev  (printed by `bun run party:deploy`)
NEXT_PUBLIC_PARTYKIT_HOST=""

# -----------------------------------------------------------------------------
# NOTE COVER UPLOADS (server-wide default storage)
# -----------------------------------------------------------------------------
# Used when a user hasn't connected their own storage in Settings → Data & sync.
# Option A — self-hostable S3-compatible bucket (preferred for Docker/self-host,
# e.g. MinIO, Cloudflare R2, Backblaze B2). Bucket must allow public reads.
# Set all four of the following to enable it:
DEFAULT_STORAGE_S3_BUCKET=""
DEFAULT_STORAGE_S3_REGION=""
DEFAULT_STORAGE_S3_ACCESS_KEY_ID=""
DEFAULT_STORAGE_S3_SECRET_ACCESS_KEY=""
# Optional: custom endpoint (MinIO/R2/B2) and public base URL for serving files.
DEFAULT_STORAGE_S3_ENDPOINT=""
DEFAULT_STORAGE_S3_PUBLIC_BASE_URL=""

# Option B — Vercel Blob. Auto-provided by Vercel when a Blob store is
# attached to the project. Used only if DEFAULT_STORAGE_S3_BUCKET is unset.
BLOB_READ_WRITE_TOKEN=""

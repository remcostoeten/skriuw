#!/usr/bin/env bash
set -Eeuo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
target="${1:-desktop}"
if [[ $# -gt 0 ]]; then shift; fi

case "$target" in
  desktop) exec "$repo_dir/tools/scripts/tauri.sh" dev "$@" ;;
  browser) exec "$repo_dir/tools/scripts/dev-with-cloud.sh" "$@" ;;
  site) exec "$repo_dir/tools/scripts/run-in.sh" apps/site dev "$@" ;;
  mobile) exec "$repo_dir/tools/scripts/run-in.sh" apps/mobile start "$@" ;;
  -h|--help|help)
    printf 'Usage: bin/dev [desktop|browser|site|mobile] [args...]\nDefault: desktop.\n'
    ;;
  *) printf 'Unknown dev target: %s. Run bin/dev --help.\n' "$target" >&2; exit 2 ;;
esac

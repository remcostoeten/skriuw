{
  "expo": {
    "name": "Skriuw",
    "slug": "skriuw",
    "owner": "remcostoeten",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "skriuw",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "dev.skriuw.app",
      "supportsTablet": false
    },
    "android": {
      "package": "dev.skriuw.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0D",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./src/features/capture/share-extension/plugin",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0D",
          "image": "./assets/splash-icon.png",
          "imageWidth": 96
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "cf3b8939-0f17-4f6f-969a-313c48900b56"
      }
    }
  }
}

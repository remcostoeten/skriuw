{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocalAiError",
  "type": "object",
  "properties": {
    "category": {
      "$ref": "#/$defs/LocalAiErrorCategory"
    },
    "message": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "category",
    "message"
  ],
  "$defs": {
    "LocalAiErrorCategory": {
      "type": "string",
      "enum": [
        "invalid_request",
        "unavailable",
        "download_failed",
        "checksum_mismatch",
        "install_failed",
        "process_failed",
        "malformed_response",
        "cancelled",
        "unsupported"
      ]
    }
  }
}

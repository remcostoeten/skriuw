{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SyncConflictReviewView",
  "description": "Versioned projection of preserved document divergences. Settled records are\nkept beside the open ones because a resolution never deletes the version it\ndid not choose.",
  "type": "object",
  "properties": {
    "open": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DocumentConflictView"
      }
    },
    "settled": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DocumentConflictView"
      }
    },
    "viewVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "required": [
    "viewVersion",
    "open",
    "settled"
  ],
  "$defs": {
    "DocumentConflictView": {
      "description": "One note whose document diverged across devices. Listing carries only what\nthe review list renders; the two complete versions are fetched per conflict\nso a long list never loads every body.",
      "type": "object",
      "properties": {
        "conflictId": {
          "type": "string"
        },
        "createdAt": {
          "type": "integer",
          "format": "int64"
        },
        "localVersionAvailable": {
          "description": "False when the local side could not be preserved, which leaves the\nincoming version as the only complete copy.",
          "type": "boolean"
        },
        "noteId": {
          "type": "string"
        },
        "reasonCode": {
          "type": "string"
        },
        "resolvedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "resolvedChoice": {
          "description": "`local`, `remote`, `merged`, or `superseded` once settled.",
          "type": [
            "string",
            "null"
          ]
        },
        "subreason": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "conflictId",
        "noteId",
        "title",
        "reasonCode",
        "createdAt",
        "localVersionAvailable"
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SyncPushRequest",
  "type": "object",
  "properties": {
    "deviceId": {
      "type": "string"
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ClientSyncOperation"
      }
    },
    "syncProtocolVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "required": [
    "syncProtocolVersion",
    "deviceId",
    "operations"
  ],
  "$defs": {
    "ClientSyncOperation": {
      "type": "object",
      "properties": {
        "baseServerSequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "clientSequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "operationId": {
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/SyncOperationPayload"
        }
      },
      "required": [
        "operationId",
        "clientSequence",
        "baseServerSequence",
        "payload"
      ]
    },
    "ContentChunkRef": {
      "type": "object",
      "properties": {
        "byteLength": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "digest",
        "byteLength"
      ]
    },
    "ContentEncoding": {
      "type": "string",
      "enum": [
        "identity"
      ]
    },
    "ContentHashAlgorithm": {
      "type": "string",
      "enum": [
        "sha256"
      ]
    },
    "ContentManifest": {
      "type": "object",
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/ContentHashAlgorithm"
        },
        "chunks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentChunkRef"
          }
        },
        "contentDigest": {
          "type": "string"
        },
        "encoding": {
          "$ref": "#/$defs/ContentEncoding"
        },
        "kind": {
          "$ref": "#/$defs/ContentManifestKind"
        },
        "manifestVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "mimeType": {
          "type": "string"
        },
        "totalByteLength": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "manifestVersion",
        "kind",
        "algorithm",
        "encoding",
        "contentDigest",
        "mimeType",
        "totalByteLength",
        "chunks"
      ]
    },
    "ContentManifestKind": {
      "type": "string",
      "enum": [
        "operation_envelope",
        "asset",
        "checkpoint"
      ]
    },
    "NodePlacement": {
      "type": "object",
      "properties": {
        "parentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "position": {
          "$ref": "#/$defs/NodePosition"
        }
      },
      "required": [
        "position"
      ]
    },
    "NodePosition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "first"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "last"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "anchorId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "before"
            }
          },
          "required": [
            "type",
            "anchorId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "anchorId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "after"
            }
          },
          "required": [
            "type",
            "anchorId"
          ]
        }
      ]
    },
    "NoteProperty": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "noteId": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/NotePropertyOption"
          }
        },
        "position": {
          "type": "integer",
          "format": "int64"
        },
        "value": {
          "$ref": "#/$defs/VersionedNotePropertyValue"
        }
      },
      "required": [
        "noteId",
        "id",
        "name",
        "value",
        "position"
      ]
    },
    "NotePropertyColor": {
      "type": "string",
      "enum": [
        "gray",
        "stone",
        "amber",
        "green",
        "blue",
        "teal",
        "rose",
        "red"
      ]
    },
    "NotePropertyField": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/NotePropertyOption"
          }
        },
        "position": {
          "type": "integer",
          "format": "int64"
        },
        "value": {
          "$ref": "#/$defs/VersionedNotePropertyValue"
        }
      },
      "required": [
        "id",
        "name",
        "value",
        "position"
      ]
    },
    "NotePropertyOption": {
      "type": "object",
      "properties": {
        "color": {
          "$ref": "#/$defs/NotePropertyColor"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "color"
      ]
    },
    "NotePropertyTemplate": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "position": {
          "type": "integer",
          "format": "int64"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NotePropertyField"
          }
        }
      },
      "required": [
        "id",
        "name",
        "position",
        "properties"
      ]
    },
    "ProviderImportReceipt": {
      "type": "object",
      "properties": {
        "importedAt": {
          "type": "integer",
          "format": "int64"
        },
        "noteId": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "sourceKey": {
          "type": "string"
        },
        "sourcePath": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "sourceKey",
        "sourcePath",
        "noteId",
        "importedAt"
      ]
    },
    "SyncOperationPayload": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "assets": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ContentManifest"
              }
            },
            "form": {
              "type": "string",
              "const": "inline"
            },
            "operation": {
              "$ref": "#/$defs/WorkspaceOperationEnvelope"
            }
          },
          "required": [
            "form",
            "operation"
          ]
        },
        {
          "type": "object",
          "properties": {
            "form": {
              "type": "string",
              "const": "chunked"
            },
            "manifest": {
              "$ref": "#/$defs/ContentManifest"
            }
          },
          "required": [
            "form",
            "manifest"
          ]
        }
      ]
    },
    "TaskPriority": {
      "type": "string",
      "enum": [
        "urgent",
        "high",
        "medium",
        "low"
      ]
    },
    "TaskSource": {
      "description": "The checklist item a task was promoted from. Both halves move together so\na task is either fully linked or fully standalone; there is no state where\nonly one half survives.",
      "type": "object",
      "properties": {
        "blockId": {
          "type": "string"
        },
        "noteId": {
          "type": "string"
        }
      },
      "required": [
        "noteId",
        "blockId"
      ]
    },
    "TaskSourceDocument": {
      "description": "The document state that a task operation writes in the same transaction as\nthe task record. Promotion, detachment, and deletion all rewrite the source\nchecklist item, and neither half may land without the other.",
      "type": "object",
      "properties": {
        "documentJson": true,
        "expectedRevision": {
          "type": "integer",
          "format": "int64"
        },
        "markdown": {
          "type": "string"
        },
        "noteId": {
          "type": "string"
        },
        "wordCount": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "noteId",
        "documentJson",
        "markdown",
        "wordCount",
        "expectedRevision"
      ]
    },
    "TaskStatus": {
      "type": "string",
      "enum": [
        "todo",
        "in_progress",
        "done"
      ]
    },
    "VersionedNotePropertyValue": {
      "type": "object",
      "properties": {
        "valueVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "number"
            },
            "value": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "date"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "select"
            },
            "value": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "multi-select"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "person"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "url"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "checkbox"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "rating"
            },
            "value": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "location"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "email"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "phone"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ]
        }
      ],
      "required": [
        "valueVersion"
      ]
    },
    "WorkspaceImage": {
      "type": "object",
      "properties": {
        "byteSize": {
          "type": "integer",
          "format": "int64"
        },
        "contentHash": {
          "type": "string"
        },
        "createdAt": {
          "type": "integer",
          "format": "int64"
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "noteId": {
          "type": "string"
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        }
      },
      "required": [
        "id",
        "noteId",
        "contentHash",
        "mimeType",
        "byteSize",
        "createdAt"
      ]
    },

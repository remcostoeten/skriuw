            },
            "id": {
              "type": "string"
            },
            "placement": {
              "$ref": "#/$defs/NodePlacement"
            },
            "title": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "create_folder"
            }
          },
          "required": [
            "type",
            "id",
            "title",
            "placement",
            "at"
          ]
        },
        {
          "type": "object",
          "properties": {
            "at": {
              "type": "integer",
              "format": "int64"
            },
            "documentJson": true,
            "id": {
              "type": "string"
            },
            "markdown": {
              "type": "string"
            },
            "placement": {
              "$ref": "#/$defs/NodePlacement"
            },
            "title": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "create_note"
            }
          },
          "required": [
            "type",
            "id",
            "title",
            "placement",
            "documentJson",
            "markdown",
            "at"
          ]
        },
        {
          "type": "object",
          "properties": {
            "at": {
              "type": "integer",
              "format": "int64"
            },
            "id": {
              "type": "string"
            },
            "title": {

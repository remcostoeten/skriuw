              "type": "integer",
              "format": "int64"
            },
            "placement": {
              "$ref": "#/$defs/NodePlacement"
            },
            "rootId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "restore_subtree"
            }
          },
          "required": [

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkspaceDelta",
  "description": "The subset of canonical state a renderer needs after specific notes\nchanged underneath it: the current document bodies plus the node records\nfor the same identifiers, so title and placement stay in step.",
  "type": "object",
  "properties": {
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/WorkspaceDocument"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/WorkspaceNode"
      }
    }
  },
  "required": [
    "documents",
    "nodes"
  ],
  "$defs": {
    "NodeKind": {
      "type": "string",
      "enum": [
        "note",
        "folder"
      ]
    },
    "SealedPayload": {
      "description": "Ciphertext together with what is needed to open it, and never the key.\n`ciphertext` and `nonce` are unpadded base64.",
      "type": "object",
      "properties": {
        "ciphertext": {
          "type": "string"
        },
        "keyId": {
          "type": "string"
        },
        "nonce": {
          "type": "string"
        },
        "scheme": {
          "type": "string"
        }
      },
      "required": [
        "scheme",
        "keyId",
        "nonce",
        "ciphertext"
      ]
    },
    "WorkspaceDocument": {
      "type": "object",
      "properties": {
        "documentJson": true,
        "markdown": {
          "type": "string"
        },
        "noteId": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "int64"
        },
        "sealed": {
          "description": "Present when the note is locked and its body is stored sealed. The\nplaintext fields then hold the empty placeholder, and a device that\nholds the lock key opens the body on request instead.",
          "anyOf": [
            {
              "$ref": "#/$defs/SealedPayload"
            },
            {
              "type": "null"
            }
          ]
        },
        "wordCount": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "noteId",
        "documentJson",
        "markdown",
        "revision",
        "wordCount"
      ]
    },
    "WorkspaceNode": {
      "type": "object",
      "properties": {
        "coverFullWidth": {
          "type": "boolean",
          "default": false
        },
        "coverGradient": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "coverImageId": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "coverPositionX": {
          "type": "number",
          "format": "double",
          "default": 50.0
        },
        "coverPositionY": {
          "type": "number",
          "format": "double",
          "default": 50.0
        },
        "coverZoom": {
          "type": "number",
          "format": "double",
          "default": 1.0
        },
        "createdAt": {
          "type": "integer",
          "format": "int64"
        },
        "deletedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/NodeKind"
        },
        "lockedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64",
          "default": null
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "pinnedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64",
          "default": null
        },
        "rank": {
          "type": "integer",
          "format": "int64"
        },
        "title": {
          "type": "string"
        },
        "updatedAt": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "kind",
        "rank",
        "title",
        "createdAt",
        "updatedAt"
      ]
    }
  }
}

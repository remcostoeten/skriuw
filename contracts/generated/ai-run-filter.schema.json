{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AiRunFilter",
  "type": "object",
  "properties": {
    "limit": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "modelId": {
      "type": [
        "string",
        "null"
      ]
    },
    "providerId": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "anyOf": [
        {
          "$ref": "#/$defs/AiRunState"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "AiRunState": {
      "type": "string",
      "enum": [
        "done",
        "cancelled",
        "timed_out",
        "failed"
      ]
    }
  }
}

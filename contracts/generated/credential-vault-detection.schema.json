{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CredentialVaultDetection",
  "type": "object",
  "properties": {
    "detail": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "$ref": "#/$defs/CredentialVaultState"
    }
  },
  "additionalProperties": false,
  "required": [
    "state"
  ],
  "$defs": {
    "CredentialVaultState": {
      "description": "Where a device can persist remote provider keys. Detection runs only when\nthe opt-in-gated provider settings surface asks for it.",
      "type": "string",
      "enum": [
        "vault-ok",
        "vault-locked",
        "vault-no-collection",
        "vault-absent",
        "vault-blocked"
      ]
    }
  }
}

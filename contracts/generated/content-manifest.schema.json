{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContentManifest",
  "type": "object",
  "properties": {
    "algorithm": {
      "$ref": "#/$defs/ContentHashAlgorithm"
    },
    "chunks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ContentChunkRef"
      }
    },
    "contentDigest": {
      "type": "string"
    },
    "encoding": {
      "$ref": "#/$defs/ContentEncoding"
    },
    "kind": {
      "$ref": "#/$defs/ContentManifestKind"
    },
    "manifestVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "mimeType": {
      "type": "string"
    },
    "totalByteLength": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "kind",
    "algorithm",
    "encoding",
    "contentDigest",
    "mimeType",
    "totalByteLength",
    "chunks"
  ],
  "$defs": {
    "ContentChunkRef": {
      "type": "object",
      "properties": {
        "byteLength": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "digest",
        "byteLength"
      ]
    },
    "ContentEncoding": {
      "type": "string",
      "enum": [
        "identity"
      ]
    },
    "ContentHashAlgorithm": {
      "type": "string",
      "enum": [
        "sha256"
      ]
    },
    "ContentManifestKind": {
      "type": "string",
      "enum": [
        "operation_envelope",
        "asset",
        "checkpoint"
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkspaceSnapshot",
  "type": "object",
  "properties": {
    "activeNoteId": {
      "type": [
        "string",
        "null"
      ]
    },
    "annotations": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/WorkspaceAnnotation"
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/WorkspaceDocument"
      }
    },
    "historyHeaders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/HistoryHeader"
      }
    },
    "images": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/WorkspaceImage"
      }
    },
    "importReceipts": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ProviderImportReceipt"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/WorkspaceNode"
      }
    },
    "people": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/WorkspacePerson"
      }
    },
    "prompts": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/WorkspacePrompt"
      }
    },
    "properties": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/NoteProperty"
      }
    },
    "propertyTemplates": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/NotePropertyTemplate"
      }
    },
    "protocolVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "references": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/NoteReferences"
      }
    },
    "settings": {
      "$ref": "#/$defs/WorkspaceSettings"
    },
    "tags": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/WorkspaceTag"
      }
    },
    "tasks": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/WorkspaceTask"
      }
    }
  },
  "required": [
    "protocolVersion",
    "nodes",
    "documents",
    "historyHeaders",
    "settings"
  ],
  "$defs": {
    "AnnotationComment": {
      "description": "A single comment in a thread. `author_id` is always `None` today; it is\ncarried so that attributing comments to collaborators later adds a value\nrather than reshaping the record.",
      "type": "object",
      "properties": {
        "authorId": {
          "type": [
            "string",
            "null"
          ]
        },
        "bodyMarkdown": {
          "type": "string"
        },
        "createdAt": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "updatedAt": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "bodyMarkdown",
        "createdAt",
        "updatedAt"
      ]
    },
    "AnnotationStatus": {
      "type": "string",
      "enum": [
        "open",
        "resolved"
      ]
    },
    "DocumentReference": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ReferenceKind"
        },
        "targetId": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "targetId"
      ]
    },
    "HistoryHeader": {
      "type": "object",
      "properties": {
        "additions": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "createdAt": {
          "type": "integer",
          "format": "int64"
        },
        "deletions": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "noteId": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "versionId": {
          "type": "string"
        },
        "wordCount": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        }
      },
      "required": [
        "noteId",
        "versionId",
        "createdAt",
        "summary"
      ]
    },
    "NodeKind": {
      "type": "string",
      "enum": [
        "note",
        "folder"
      ]
    },
    "NoteProperty": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "noteId": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/NotePropertyOption"
          }
        },
        "position": {
          "type": "integer",
          "format": "int64"
        },
        "value": {
          "$ref": "#/$defs/VersionedNotePropertyValue"
        }
      },
      "required": [
        "noteId",
        "id",
        "name",
        "value",
        "position"
      ]
    },
    "NotePropertyColor": {
      "type": "string",
      "enum": [
        "gray",
        "stone",
        "amber",
        "green",
        "blue",
        "teal",
        "rose",
        "red"
      ]
    },
    "NotePropertyField": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/NotePropertyOption"
          }
        },
        "position": {
          "type": "integer",
          "format": "int64"
        },
        "value": {
          "$ref": "#/$defs/VersionedNotePropertyValue"
        }
      },
      "required": [
        "id",
        "name",
        "value",
        "position"
      ]
    },
    "NotePropertyOption": {
      "type": "object",
      "properties": {
        "color": {
          "$ref": "#/$defs/NotePropertyColor"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "color"
      ]
    },
    "NotePropertyTemplate": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "position": {
          "type": "integer",
          "format": "int64"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NotePropertyField"
          }
        }
      },
      "required": [
        "id",
        "name",
        "position",
        "properties"
      ]
    },
    "NoteReferences": {
      "type": "object",
      "properties": {
        "noteId": {
          "type": "string"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocumentReference"
          }
        }
      },
      "required": [
        "noteId",
        "targets"
      ]
    },
    "PromptInputShape": {
      "description": "The material a prompt expects to be filled with. Prompts are\nprovider-agnostic, so this describes the caller's obligation rather than any\nprovider's message format.",
      "oneOf": [
        {
          "description": "The user prompt carries the current editor selection.",
          "type": "string",
          "const": "selection"
        },
        {
          "description": "The user prompt carries the whole note.",
          "type": "string",
          "const": "note"
        },
        {
          "description": "The user prompt is whatever the caller types.",
          "type": "string",
          "const": "freeform"
        }
      ]
    },
    "PromptParameters": {
      "description": "The provider-neutral generation defaults a prompt ships with. They mirror\nthe completion seam's parameters so a prompt can be fired without a second\ntranslation step, and they never carry a provider, model, or credential.",
      "type": "object",
      "properties": {
        "maxOutputBytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "temperatureMillis": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "required": [
        "maxOutputBytes"
      ]
    },
    "ProviderImportReceipt": {
      "type": "object",
      "properties": {
        "importedAt": {
          "type": "integer",
          "format": "int64"
        },
        "noteId": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "sourceKey": {
          "type": "string"
        },
        "sourcePath": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "sourceKey",
        "sourcePath",
        "noteId",
        "importedAt"
      ]
    },
    "ReferenceKind": {
      "type": "string",
      "enum": [
        "tag",
        "person",
        "note"
      ]
    },
    "TaskPriority": {
      "type": "string",
      "enum": [
        "urgent",
        "high",
        "medium",
        "low"
      ]
    },
    "TaskSource": {
      "description": "The checklist item a task was promoted from. Both halves move together so\na task is either fully linked or fully standalone; there is no state where\nonly one half survives.",
      "type": "object",
      "properties": {
        "blockId": {
          "type": "string"
        },
        "noteId": {
          "type": "string"
        }
      },
      "required": [
        "noteId",
        "blockId"
      ]
    },
    "TaskStatus": {
      "type": "string",
      "enum": [
        "todo",
        "in_progress",
        "done"
      ]
    },
    "VersionedNotePropertyValue": {
      "type": "object",
      "properties": {
        "valueVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "number"
            },
            "value": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "date"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "select"
            },
            "value": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "multi-select"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "person"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "url"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "checkbox"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "rating"
            },
            "value": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "location"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "email"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "phone"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ]
        }
      ],
      "required": [
        "valueVersion"
      ]
    },
    "WorkspaceAnnotation": {
      "description": "A comment thread anchored to a range of note text. The anchor itself lives\nin the document as a mark carrying this id; the thread survives the anchor\nbeing deleted so it can be surfaced as an orphan instead of disappearing.",
      "type": "object",
      "properties": {
        "anchorText": {
          "type": "string"
        },
        "comments": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/AnnotationComment"
          }
        },
        "createdAt": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "noteId": {
          "type": "string"
        },
        "resolvedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "status": {
          "$ref": "#/$defs/AnnotationStatus"
        }
      },
      "required": [
        "id",
        "noteId",
        "status",
        "anchorText",
        "createdAt"
      ]
    },
    "WorkspaceDocument": {
      "type": "object",
      "properties": {
        "documentJson": true,
        "markdown": {
          "type": "string"
        },
        "noteId": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "int64"
        },
        "wordCount": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "noteId",
        "documentJson",
        "markdown",
        "revision",
        "wordCount"
      ]
    },
    "WorkspaceImage": {
      "type": "object",
      "properties": {
        "byteSize": {
          "type": "integer",
          "format": "int64"
        },
        "contentHash": {
          "type": "string"
        },
        "createdAt": {
          "type": "integer",
          "format": "int64"
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "noteId": {
          "type": "string"
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        }
      },
      "required": [
        "id",
        "noteId",
        "contentHash",
        "mimeType",
        "byteSize",
        "createdAt"
      ]
    },
    "WorkspaceNode": {
      "type": "object",
      "properties": {
        "coverFullWidth": {
          "type": "boolean",
          "default": false
        },
        "coverImageId": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "coverPositionX": {
          "type": "number",
          "format": "double",
          "default": 50.0
        },
        "coverPositionY": {
          "type": "number",
          "format": "double",
          "default": 50.0
        },
        "coverZoom": {
          "type": "number",
          "format": "double",
          "default": 1.0
        },
        "createdAt": {
          "type": "integer",
          "format": "int64"
        },
        "deletedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/NodeKind"
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "pinnedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64",
          "default": null
        },
        "rank": {
          "type": "integer",
          "format": "int64"
        },
        "title": {
          "type": "string"
        },
        "updatedAt": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "kind",
        "rank",
        "title",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkspacePerson": {
      "type": "object",
      "properties": {
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "integer",
          "format": "int64",
          "default": 0
        },
        "createdIn": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "initials": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "updatedAt": {
          "type": "integer",
          "format": "int64",
          "default": 0
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "WorkspacePrompt": {
      "description": "A prompt the user owns. It is ordinary workspace data: canonical in SQLite,\nreplicated, exported, and archived alongside notes. A prompt carries no\nprovider, model, endpoint, or credential, so it is never a secret.",
      "type": "object",
      "properties": {
        "builtInId": {
          "description": "The built-in this prompt shadows, if any. A shadow hides its built-in\neverywhere the library is listed and can be reset by deleting it, which\nis why a shipped built-in update can never overwrite a user edit.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "createdAt": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "inputShape": {
          "$ref": "#/$defs/PromptInputShape"
        },
        "name": {
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/PromptParameters"
        },
        "systemPrompt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "name",
        "systemPrompt",
        "inputShape",
        "parameters",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkspaceSettings": {
      "type": "object",
      "properties": {
        "compactSidebar": {
          "type": "boolean",
          "default": false
        },
        "editorFont": {
          "type": "string",
          "default": "inter"
        },
        "editorLineHeight": {
          "type": "string",
          "default": "comfortable"
        },
        "editorPlaceholder": {
          "type": "string",
          "default": "Start writing..."
        },
        "reduceMotion": {
          "type": "boolean",
          "default": false
        },
        "rememberLastNote": {
          "type": "boolean",
          "default": true
        },
        "settingsVersion": {
          "type": "integer",
          "format": "uint16",
          "default": 1,
          "maximum": 65535,
          "minimum": 0
        },
        "showLineNumbers": {
          "type": "boolean",
          "default": true
        },
        "showPageIcons": {
          "type": "boolean",
          "default": true
        },
        "theme": {
          "type": "string",
          "default": "midnight"
        }
      },
      "additionalProperties": true
    },
    "WorkspaceTag": {
      "type": "object",
      "properties": {
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "integer",
          "format": "int64",
          "default": 0
        },
        "createdIn": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "updatedAt": {
          "type": "integer",
          "format": "int64",
          "default": 0
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "WorkspaceTask": {
      "type": "object",
      "properties": {
        "assigneeIds": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "createdAt": {
          "type": "integer",
          "format": "int64"
        },
        "description": {
          "type": "string",
          "default": ""
        },
        "detachedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64",
          "default": null
        },
        "dueDate": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/TaskPriority"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "tagIds": {
          "type": "array",
          "default": [],

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AiCompletionEvent",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "text": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "delta"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "requestId",
        "sequence",
        "text"
      ]
    },
    {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "done"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/AiUsage"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "requestId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "cancelled"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "requestId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "timeout"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "requestId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/AiProviderError"
        },
        "requestId": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "provider_error"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "requestId",
        "error"
      ]
    }
  ],
  "$defs": {
    "AiProviderError": {
      "type": "object",
      "properties": {
        "category": {
          "$ref": "#/$defs/AiProviderErrorCategory"
        },
        "message": {
          "type": "string"
        },
        "providerId": {
          "type": "string"
        },
        "recoveryAction": {
          "$ref": "#/$defs/AiRecoveryAction"
        }
      },
      "additionalProperties": false,
      "required": [
        "providerId",
        "category",
        "message",
        "recoveryAction"
      ]
    },
    "AiProviderErrorCategory": {
      "type": "string",
      "enum": [
        "unavailable_provider",
        "missing_credential",
        "invalid_credential",
        "quota_exhausted",
        "rate_limited",
        "rejected_request",
        "transport_failure",
        "malformed_response",
        "internal_failure"
      ]
    },
    "AiRecoveryAction": {
      "type": "string",
      "enum": [
        "configure_credential",
        "retry",
        "choose_different_model",
        "check_provider_status",
        "reduce_request",
        "contact_provider",
        "none"
      ]
    },
    "AiUsage": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "inputTokens",
        "outputTokens"
      ]
    }
  }
}

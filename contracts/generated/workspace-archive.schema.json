{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkspaceArchive",
  "type": "object",
  "properties": {
    "activeNoteId": {
      "type": [
        "string",
        "null"
      ]
    },
    "archiveVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/WorkspaceDocument"
      }
    },
    "exportedAt": {
      "type": "integer",
      "format": "int64"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/WorkspaceNode"
      }
    },
    "people": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/WorkspacePerson"
      }
    },
    "properties": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/NoteProperty"
      }
    },
    "propertyTemplates": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/NotePropertyTemplate"
      }
    },
    "protocolVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "settings": {
      "$ref": "#/$defs/WorkspaceSettings"
    },
    "tags": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/WorkspaceTag"
      }
    }
  },
  "required": [
    "archiveVersion",
    "protocolVersion",
    "exportedAt",
    "nodes",
    "documents",
    "settings"
  ],
  "$defs": {
    "NodeKind": {
      "type": "string",
      "enum": [
        "note",
        "folder"
      ]
    },
    "NoteProperty": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "noteId": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/NotePropertyOption"
          }
        },
        "position": {
          "type": "integer",
          "format": "int64"
        },
        "value": {
          "$ref": "#/$defs/VersionedNotePropertyValue"
        }
      },
      "required": [
        "noteId",
        "id",
        "name",
        "value",
        "position"
      ]
    },
    "NotePropertyColor": {
      "type": "string",
      "enum": [
        "gray",
        "stone",
        "amber",
        "green",
        "blue",
        "teal",
        "rose",
        "red"
      ]
    },
    "NotePropertyField": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/NotePropertyOption"
          }
        },
        "position": {
          "type": "integer",
          "format": "int64"
        },
        "value": {
          "$ref": "#/$defs/VersionedNotePropertyValue"
        }
      },
      "required": [
        "id",
        "name",
        "value",
        "position"
      ]
    },
    "NotePropertyOption": {
      "type": "object",
      "properties": {
        "color": {
          "$ref": "#/$defs/NotePropertyColor"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "color"
      ]
    },
    "NotePropertyTemplate": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "position": {
          "type": "integer",
          "format": "int64"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NotePropertyField"
          }
        }
      },
      "required": [
        "id",
        "name",
        "position",
        "properties"
      ]
    },
    "VersionedNotePropertyValue": {
      "type": "object",
      "properties": {
        "valueVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "number"
            },
            "value": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "date"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "select"
            },
            "value": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "multi-select"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "person"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "url"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "checkbox"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "rating"
            },
            "value": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "location"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "email"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "phone"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ]
        }
      ],
      "required": [
        "valueVersion"
      ]
    },
    "WorkspaceDocument": {
      "type": "object",
      "properties": {
        "documentJson": true,
        "markdown": {
          "type": "string"
        },
        "noteId": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "int64"
        },
        "wordCount": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "noteId",
        "documentJson",
        "markdown",
        "revision",
        "wordCount"
      ]
    },
    "WorkspaceNode": {
      "type": "object",
      "properties": {
        "coverFullWidth": {
          "type": "boolean",
          "default": false
        },
        "coverImageId": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "coverPositionX": {
          "type": "number",
          "format": "double",
          "default": 50.0
        },
        "coverPositionY": {
          "type": "number",
          "format": "double",
          "default": 50.0
        },
        "coverZoom": {
          "type": "number",
          "format": "double",
          "default": 1.0
        },
        "createdAt": {
          "type": "integer",
          "format": "int64"
        },
        "deletedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/NodeKind"
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "pinnedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64",
          "default": null
        },
        "rank": {
          "type": "integer",
          "format": "int64"
        },
        "title": {
          "type": "string"
        },
        "updatedAt": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "kind",
        "rank",
        "title",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkspacePerson": {
      "type": "object",
      "properties": {
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "integer",
          "format": "int64",
          "default": 0
        },
        "createdIn": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "initials": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "updatedAt": {
          "type": "integer",
          "format": "int64",
          "default": 0
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "WorkspaceSettings": {
      "type": "object",
      "properties": {
        "compactSidebar": {
          "type": "boolean",
          "default": false
        },
        "editorFont": {
          "type": "string",
          "default": "inter"
        },
        "editorLineHeight": {
          "type": "string",
          "default": "comfortable"
        },
        "editorPlaceholder": {
          "type": "string",
          "default": "Start writing..."
        },
        "reduceMotion": {
          "type": "boolean",
          "default": false
        },
        "rememberLastNote": {
          "type": "boolean",
          "default": true
        },
        "settingsVersion": {
          "type": "integer",
          "format": "uint16",
          "default": 1,
          "maximum": 65535,
          "minimum": 0
        },
        "showLineNumbers": {
          "type": "boolean",
          "default": true
        },
        "showPageIcons": {
          "type": "boolean",
          "default": true
        },
        "theme": {
          "type": "string",
          "default": "midnight"
        }
      },
      "additionalProperties": true
    },
    "WorkspaceTag": {
      "type": "object",
      "properties": {
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "integer",
          "format": "int64",
          "default": 0
        },
        "createdIn": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "updatedAt": {
          "type": "integer",
          "format": "int64",
          "default": 0
        }
      },
      "required": [
        "id",
        "name"
      ]
    }
  }
}

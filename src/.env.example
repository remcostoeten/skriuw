# Storage Configuration
# Available options: localStorage, drizzleLibsqlHttp, drizzleTauriSqlite, instantdb, pglite
VITE_STORAGE_ADAPTER=localStorage

# Drizzle Configuration
# Target environment: "web" for libsql/Turso, "desktop" for SQLite
DRIZZLE_TARGET=desktop

# LibSQL/Turso Configuration (when DRIZZLE_TARGET=web)
LIBSQL_DATABASE_URL=libsql://popular-blitzkrieg-remcostoeten.aws-eu-west-1.turso.io
LIBSQL_AUTH_TOKEN=***REMOVED***

# SQLite Configuration (when DRIZZLE_TARGET=desktop)
SQLITE_DATABASE_PATH=./local.sqlite

# InstantDB Configuration (when using instantdb adapter)
# VITE_INSTANTDB_APP_ID=your_app_id_here

# PGLite Configuration (when using pglite adapter)
# Additional PGLite-specific options can be added here
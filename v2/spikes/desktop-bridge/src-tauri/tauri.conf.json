{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skriuw Desktop Bridge Spike",
  "version": "0.0.0",
  "identifier": "dev.skriuw.desktop-bridge-spike",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Skriuw desktop bridge measurement",
        "width": 900,
        "height": 700
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkspaceArchive",
  "type": "object",
  "properties": {
    "activeNoteId": {
      "type": [
        "string",
        "null"
      ]
    },
    "archiveVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/WorkspaceDocument"
      }
    },
    "exportedAt": {
      "type": "integer",
      "format": "int64"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/WorkspaceNode"
      }
    },
    "protocolVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "settings": {
      "$ref": "#/$defs/WorkspaceSettings"
    }
  },
  "required": [
    "archiveVersion",
    "protocolVersion",
    "exportedAt",
    "nodes",
    "documents",
    "settings"
  ],
  "$defs": {
    "NodeKind": {
      "type": "string",
      "enum": [
        "note",
        "folder"
      ]
    },
    "WorkspaceDocument": {
      "type": "object",
      "properties": {
        "documentJson": true,
        "markdown": {
          "type": "string"
        },
        "noteId": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "int64"
        },
        "wordCount": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "noteId",
        "documentJson",
        "markdown",
        "revision",
        "wordCount"
      ]
    },
    "WorkspaceNode": {
      "type": "object",
      "properties": {
        "createdAt": {
          "type": "integer",
          "format": "int64"
        },
        "deletedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/NodeKind"
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "rank": {
          "type": "integer",
          "format": "int64"
        },
        "title": {
          "type": "string"
        },
        "updatedAt": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "kind",
        "rank",
        "title",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkspaceSettings": {
      "type": "object",
      "properties": {
        "compactSidebar": {
          "type": "boolean",
          "default": false
        },
        "editorFont": {
          "type": "string",
          "default": "inter"
        },
        "editorLineHeight": {
          "type": "string",
          "default": "comfortable"
        },
        "editorPlaceholder": {
          "type": "string",
          "default": "Start writing..."
        },
        "reduceMotion": {
          "type": "boolean",
          "default": false
        },
        "rememberLastNote": {
          "type": "boolean",
          "default": true
        },
        "settingsVersion": {
          "type": "integer",
          "format": "uint16",
          "default": 1,
          "maximum": 65535,
          "minimum": 0
        },
        "showLineNumbers": {
          "type": "boolean",
          "default": true
        },
        "showPageIcons": {
          "type": "boolean",
          "default": true
        },
        "theme": {
          "type": "string",
          "default": "midnight"
        }
      },
      "additionalProperties": true
    }
  }
}

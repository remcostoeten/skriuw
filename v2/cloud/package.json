    "test": "vitest run",
    "check": "bun run types:check && bun run typecheck && bun run test",
    "deploy:dry": "wrangler deploy --dry-run"
  },
  "type": "module",
  "dependencies": {
    "@cfworker/json-schema": "4.1.1"
  }
}

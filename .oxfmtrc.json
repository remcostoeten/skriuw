{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "ignorePatterns": [
    "v1-final/**",
    "contracts/**",
    "docs/**",
    "__tests__/fixtures/**",
    "tools/packaging/**",
    "packages/theme/tokens.ts",
    "packages/icons/generated/**",
    "apps/workspace/src/features/settings-dialog/search-copy.generated.ts",
    "tools/oxlint/anti-slop/**",
    "**/*.{json,jsonc,md,mdx,css,html,yml,yaml,toml,webmanifest}"
  ]
}

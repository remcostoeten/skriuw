{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "ignorePatterns": [
    "v1/**",
    "contracts/**",
    "fixtures/**",
    "packaging/**",
    "bucket/**",
    "Casks/**",
    "packages/theme/tokens.ts",
    "packages/icons/generated/**",
    "tools/oxlint/anti-slop/**",
    "**/*.{json,jsonc,md,mdx,css,html,yml,yaml,toml,webmanifest}"
  ]
}

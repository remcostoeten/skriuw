{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"bunVersion": "1.3.14",
	"installCommand": "cd v2/app && bun install --frozen-lockfile",
	"buildCommand": "bash v2/scripts/vercel-build.sh",
	"outputDirectory": "v2/.build/vercel-public",
	"redirects": [
		{ "source": "/", "destination": "/app/", "permanent": false },
		{ "source": "/app", "destination": "/app/", "permanent": true }
	],
	"headers": [
		{
			"source": "/app/assets/:asset*",
			"headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
		}
	]
}

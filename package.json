{
  "name": "skriuw",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/workspace",
    "apps/site",
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "menu": "dev-menu",
    "dev": "dev-menu",
    "dev:desktop": "bin/dev desktop",
    "dev:browser": "bin/dev browser",
    "site": "bin/dev site",
    "build:site": "bin/build site",
    "build:browser": "bin/build browser",
    "build": "bin/build browser",
    "tauri": "scripts/tauri.sh",
    "tauri:build": "bin/build desktop",
    "test": "vitest run",
    "typecheck": "scripts/run-in.sh apps/workspace typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --disable-nested-config",
    "format:check": "oxfmt --disable-nested-config --check",
    "check": "bin/check",
    "mobile": "bin/dev mobile",
    "check:browser": "bin/check browser",
    "check:mobile": "bin/check mobile",
    "setup": "bin/setup",
    "generate": "bin/generate"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.85.0",
    "@remcostoeten/dev-menu": "^0.2.2",
    "@vitest/coverage-v8": "4.1.10",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "vitest": "4.1.10"
  }
}

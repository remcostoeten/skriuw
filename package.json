{
	"name": "skriuw",
	"version": "0.17.0",
	"private": true,
	"description": "A quiet writing workspace for notes, journaling, sharing, and planning.",
	"keywords": [
		"bun",
		"collaboration",
		"journal",
		"knowledge-base",
		"nextjs",
		"notes",
		"tauri",
		"writing"
	],
	"homepage": "https://github.com/remcostoeten/skriuw#readme",
	"bugs": {
		"url": "https://github.com/remcostoeten/skriuw/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Remco Stoeten",
		"email": "stoetenremco.rs@gmail.com",
		"url": "https://remcostoeten.nl",
		"github": "https://github.com/remcostoeten",
		"twitter": "https://twitter.com/remcostoeten_nl"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/remcostoeten/skriuw.git"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"postinstall": "prisma generate && husky",
		"dev": "bun run --cwd apps/web dev",
		"coverage:check": "bun scripts/coverage-tui.ts --json coverage.json --threshold=65",
		"coverage:report": "bun scripts/coverage-tui.ts --markdown",
		"coverage:dashboard": "bun scripts/coverage-dashboard.ts",
		"coverage:badges": "bun scripts/coverage-badge.ts",
		"build": "bun run --cwd apps/web build",
		"build:verified": "bun scripts/verified-build.ts",
		"start": "bun run --cwd apps/web start",
		"test": "bun run test:unit",
		"test:unit": "bun run --cwd apps/web test:unit",
		"test:unit:coverage": "bun run --cwd apps/web test:unit:coverage",
		"test:unit:coverage:ui": "bun scripts/coverage-tui.ts",
		"test:smoke": "bun run --cwd apps/web test:smoke",
		"test:skeleton": "bun run --cwd apps/web test:skeleton",
		"skeleton:report": "bun scripts/skeleton-report.ts",
		"lint": "oxlint apps/web/src apps/web/skeleton-qa.config.ts apps/web/next.config.ts apps/web/playwright.config.ts apps/web/postcss.config.js apps/extension/src apps/extension/manifest.config.ts apps/extension/vite.config.ts packages/web-spa/src packages/web-spa/vite.config.ts scripts dev-menu.config.ts prisma.config.ts oxlint.custom.js",
		"format": "oxfmt",
		"check:portable": "bun scripts/check-portable.ts",
		"colors:audit": "bun scripts/color-audit.ts",
		"colors:audit:strict": "bun scripts/color-audit.ts --strict",
		"seed:welcome-bundle": "bun scripts/seed-welcome-bundle.ts",
		"party:dev": "wrangler dev",
		"party:deploy": "wrangler deploy",
		"dev:all": "bun scripts/dev-all.ts"
	},
	"dependencies": {
		"@ai-sdk/google": "^3",
		"@ai-sdk/groq": "^3",
		"@blocknote/core": "^0.46.2",
		"@blocknote/mantine": "0.46.2",
		"@blocknote/react": "^0.46.2",
		"@blocknote/shadcn": "0.46.2",
		"@hookform/resolvers": "^3.10.0",
		"@number-flow/react": "^0.6.0",
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"@radix-ui/react-context-menu": "^2.2.15",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.6",
		"@radix-ui/react-label": "^2.1.7",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-switch": "^1.2.5",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@remcostoeten/analytics": "^1.5.0",
		"@remcostoeten/auth-drawer": "^0.3.2",
		"@remcostoeten/use-shortcut": "^2.3.0",
		"@tanstack/query-async-storage-persister": "^5.101.0",
		"@tanstack/react-query": "^5.83.0",
		"@tanstack/react-query-persist-client": "^5.101.0",
		"@tanstack/react-virtual": "^3.13.24",
		"@vercel/analytics": "^2.0.1",
		"ai": "^6",
		"better-auth": "^1.6.11",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^3.6.0",
		"facehash": "^0.1.0",
		"fflate": "^0.8.2",
		"framer-motion": "^12.35.0",
		"idb-keyval": "^6.2.5",
		"lucide-react": "^0.462.0",
		"next": "16.1.6",
		"partyserver": "^0.5.8",
		"pg": "^8.21.0",
		"prosemirror-history": "^1.5.0",
		"prosemirror-state": "^1.4.4",
		"prosemirror-view": "^1.41.4",
		"react": "19.2.4",
		"react-day-picker": "^10.0.0",
		"react-dom": "19.2.4",
		"react-force-graph-2d": "^1.29.1",
		"react-hook-form": "^7.61.1",
		"server-only": "^0.0.1",
		"shiki": "^4.0.2",
		"tailwind-merge": "^2.6.0",
		"tailwindcss-animate": "^1.0.7",
		"y-partyserver": "^2.2.0",
		"y-prosemirror": "^1.3.7",
		"y-protocols": "^1.0.7",
		"yjs": "^13.6.31",
		"zod": "^3.25.76",
		"zustand": "^5.0.5"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260705.1",
		"@next/playwright": "^16.2.6",
		"@playwright/test": "^1.59.1",
		"@tailwindcss/postcss": "^4.2.1",
		"@tailwindcss/typography": "^0.5.16",
		"@types/node": "^22.16.5",
		"@types/pg": "^8.20.0",
		"@types/pixelmatch": "^5.2.6",
		"@types/pngjs": "^6.0.5",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"dotenv": "^17.4.2",
		"fake-indexeddb": "^6.2.5",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8",
		"oxfmt": "^0.36.0",
		"oxlint": "^1.51.0",
		"pixelmatch": "^7.2.0",
		"pngjs": "^7.0.0",
		"postcss": "^8.5.6",
		"prisma": "^7.8.0",
		"shadcn": "^4.7.0",
		"tailwindcss": "^4.2.1",
		"typescript": "^5.8.3",
		"wrangler": "^4.103.0"
	},
	"overrides": {
		"@mantine/core": "8.3.18",
		"@mantine/hooks": "8.3.18",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"prosemirror-model": "1.25.4",
		"prosemirror-view": "1.42.0"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,mjs,cjs}": [
			"oxlint --fix",
			"oxfmt"
		],
		"*.{json,css,md,html}": [
			"oxfmt"
		]
	},
	"engines": {
		"bun": ">=1.3.14",
		"node": ">=24"
	},
	"packageManager": "bun@1.3.14"
}

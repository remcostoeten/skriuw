{
  "name": "skriuw",
  "version": "0.11.0",
  "description": "A quiet writing workspace for notes, journaling, sharing, and planning.",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Remco Stoeten",
    "email": "stoetenremco.rs@gmail.com",
    "url": "https://remcostoeten.nl",
    "twitter": "https://twitter.com/remcostoeten_nl",
    "github": "https://github.com/remcostoeten"
  },
  "keywords": [
    "writing",
    "notes",
    "journal",
    "knowledge-base",
    "collaboration",
    "nextjs",
    "bun",
    "tauri"
  ],
  "homepage": "https://github.com/remcostoeten/skriuw#readme",
  "bugs": {
    "url": "https://github.com/remcostoeten/skriuw/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/remcostoeten/skriuw.git"
  },
  "packageManager": "bun@1.3.14",
  "type": "module",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "build:verified": "bun scripts/verified-build.ts",
    "start": "bun run --cwd apps/web start",
    "test": "bun run test:unit",
    "test:unit": "bun run --cwd apps/web test:unit",
    "test:smoke": "bun run --cwd apps/web test:smoke",
    "test:skeleton": "bun run --cwd apps/web test:skeleton",
    "skeleton:report": "bun scripts/skeleton-report.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "check:portable": "bun scripts/check-portable.ts",
    "colors:audit": "bun scripts/color-audit.ts",
    "colors:audit:strict": "bun scripts/color-audit.ts --strict",
    "seed:welcome-bundle": "bun scripts/seed-welcome-bundle.ts",
    "party:dev": "wrangler dev",
    "party:deploy": "wrangler deploy",
    "dev:all": "bun scripts/dev-all.ts"
  },
  "dependencies": {

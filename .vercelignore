# Frozen v1 product line. This Vercel project builds v2 only, and v1 carries
# both the ~5GB Tauri target dir and Expo's 150MB native .so files, which
# exceed Vercel's 100MB per-file upload limit.
v1

# Build artifacts / caches
.next
node_modules
**/node_modules
**/target
*.tsbuildinfo

# Local-only
.env
.env.*
!.env.example
.claude

# Local data/build dirs (CLI deploys)
.build
.data

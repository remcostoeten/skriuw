generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth ─────────────────────────────────────────────────────────────

model User {
  id                String    @id
  name              String
  email             String    @unique
  emailVerified     Boolean   @default(false) @map("email_verified")
  image             String?
  role              String?   @default("user")
  username          String?   @unique
  displayUsername   String?   @map("display_username")
  avatarColor       String?   @map("avatar_color")
  editorPreferences Json?     @map("editor_preferences")
  starterSeededAt   DateTime? @map("starter_seeded_at")
  banned            Boolean?
  banReason         String?   @map("ban_reason")
  banExpires        DateTime? @map("ban_expires")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  sessions               Session[]
  accounts               Account[]
  passkeys               Passkey[]
  notes                  Note[]
  folders                Folder[]
  noteVersions           NoteVersion[]
  noteLinks              NoteLink[]
  noteShares             NoteShare[]
  journalEntries         JournalEntry[]
  journalLinks           JournalLink[]
  journalTags            JournalTag[]
  journalFeedTokens      JournalFeedToken[]
  calendarSubscriptions  CalendarSubscription[]
  userRecents            UserRecent[]
  aiProviderKeys         AiProviderKey[]
  syncTokens             SyncToken[]
  syncEvents             SyncEvent[]
  aiUsageLogs            AiUsageLog[]
  aiErrorEvents          AiErrorEvent[]
  sentCollabRequests     CollaborationRequest[] @relation("SentCollabRequests")
  receivedCollabRequests CollaborationRequest[] @relation("ReceivedCollabRequests")
  noteCollaborations     NoteCollaborator[]     @relation("NoteCollaborations")
  sentCollaborations     NoteCollaborator[]     @relation("SentCollaborations")
  notifications          Notification[]
  people                 Person[]
  noteTagMeta            NoteTagMeta[]
  tasks                  Task[]
  storageConfig          UserStorageConfig?

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime @map("expires_at")
  token          String   @unique
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?  @map("impersonated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("account")
}

model Passkey {
  id           String   @id
  name         String?
  publicKey    String   @map("public_key")
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String   @map("credential_id")
  counter      Int
  deviceType   String   @map("device_type")
  backedUp     Boolean  @map("backed_up")
  transports   String?
  createdAt    DateTime @default(now()) @map("created_at")
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verification")
}

model RateLimit {
  id          String  @id
  key         String  @unique
  count       Int     @default(0)
  lastRequest BigInt? @map("last_request")

  @@map("rate_limit")
}

model DeviceCode {
  id              String    @id
  deviceCode      String    @unique @map("device_code")
  userCode        String    @unique @map("user_code")
  userId          String?   @map("user_id")
  expiresAt       DateTime  @map("expires_at")
  status          String
  lastPolledAt    DateTime? @map("last_polled_at")
  pollingInterval Int?      @map("polling_interval")
  clientId        String?   @map("client_id")
  scope           String?

  @@index([userId])
  @@map("device_codes")
}

// ─── Desktop Sync ────────────────────────────────────────────────────────────

model SyncToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String    @unique @map("token_hash")
  tokenPrefix String    @map("token_prefix")
  scopes      String[]  @default(["sync:read"])
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([userId, revokedAt, expiresAt])
  @@map("sync_tokens")
}

model SyncEvent {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenId        String?  @map("token_id") @db.Uuid
  operation      String
  status         String
  resourceId     String?  @map("resource_id") @db.Uuid
  resourceName   String?  @map("resource_name")
  message        String?
  idempotencyKey String?  @map("idempotency_key")
  source         String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([tokenId, createdAt(sort: Desc)])
  @@map("sync_events")
}

// ─── Notes ───────────────────────────────────────────────────────────────────

model Folder {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  parentId  String?   @map("parent_id") @db.Uuid
  parent    Folder?   @relation("FolderParent", fields: [parentId], references: [id], onDelete: SetNull)
  children  Folder[]  @relation("FolderParent")
  notes     Note[]
  sortOrder Int       @default(0) @map("sort_order")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([userId, deletedAt])
  @@index([userId, parentId, sortOrder, createdAt])
  @@map("folders")
}

model Note {
  id                    String                 @id @default(uuid()) @db.Uuid
  userId                String                 @map("user_id")
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  content               String
  richContent           Json?                  @map("rich_content")
  preferredEditorMode   String?                @map("preferred_editor_mode")
  parentId              String?                @map("parent_id") @db.Uuid
  parent                Folder?                @relation(fields: [parentId], references: [id], onDelete: SetNull)
  sortOrder             Int                    @default(0) @map("sort_order")
  tags                  String[]               @default([])
  properties            Json?                  @map("properties")
  icon                  String?
  cover                 String?
  annotationScene       String?                @map("annotation_scene")
  journalMeta           Json?                  @map("journal_meta")
  semanticEmbedding     Json?                  @map("semantic_embedding")
  versions              NoteVersion[]
  outgoingLinks         NoteLink[]             @relation("NoteOutgoingLinks")
  shares                NoteShare[]
  deletedAt             DateTime?              @map("deleted_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  collaborationRequests CollaborationRequest[]
  collaborators         NoteCollaborator[]

  @@index([userId, deletedAt, createdAt])
  @@index([userId, parentId, sortOrder, createdAt])
  @@map("notes")
}

model NoteShare {
  id     String @id @default(uuid()) @db.Uuid
  token  String @unique
  noteId String @map("note_id") @db.Uuid
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Snapshot frozen at publish / re-publish time — the public view never reads the live note.
  name                String
  content             String
  richContent         Json?   @map("rich_content")
  preferredEditorMode String  @default("block") @map("preferred_editor_mode")
  // Author name snapshot. Null → the public page is anonymous.
  authorName          String? @map("author_name")

  // Access controls
  passwordHash String?   @map("password_hash")
  viewOnce     Boolean   @default(false) @map("view_once")
  expiresAt    DateTime? @map("expires_at")
  consumedAt   DateTime? @map("consumed_at")
  revokedAt    DateTime? @map("revoked_at")
  viewCount    Int       @default(0) @map("view_count")
  lastViewedAt DateTime? @map("last_viewed_at")

  views NoteShareView[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([noteId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("note_shares")
}

model NoteShareView {
  id      String    @id @default(uuid()) @db.Uuid
  shareId String    @map("share_id") @db.Uuid
  share   NoteShare @relation(fields: [shareId], references: [id], onDelete: Cascade)

  // Salted hash of (ip + user-agent) — approximates a unique viewer without
  // storing any PII. Never reversible to an address.
  viewerHash String  @map("viewer_hash")
  referrer   String?
  country    String?

  viewedAt DateTime @default(now()) @map("viewed_at")

  @@index([shareId, viewedAt(sort: Desc)])
  @@index([shareId, viewerHash])
  @@map("note_share_views")
}

model NoteVersion {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId              String   @map("note_id") @db.Uuid
  note                Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  name                String
  content             String
  richContent         Json?    @map("rich_content")
  preferredEditorMode String   @default("block") @map("preferred_editor_mode")
  parentId            String?  @map("parent_id") @db.Uuid
  tags                String[] @default([])
  properties          Json?    @map("properties")
  reason              String
  contentHash         String   @map("content_hash")
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([userId, noteId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("note_versions")
}

// Persisted knowledge-graph edges. One row per outgoing link or tag membership,
// rewritten whenever a note is saved (see syncNoteLinks in notes/actions.ts).
// targetNoteId is null for wiki links (resolved by title at read time) and tags.
model NoteLink {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceNoteId String   @map("source_note_id") @db.Uuid
  sourceNote   Note     @relation("NoteOutgoingLinks", fields: [sourceNoteId], references: [id], onDelete: Cascade)
  targetNoteId String?  @map("target_note_id") @db.Uuid
  targetLabel  String   @map("target_label")
  kind         String
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([sourceNoteId, kind, targetLabel])
  @@index([userId, sourceNoteId])
  @@index([userId, targetNoteId])
  @@map("note_links")
}

// A reusable workspace person. Referenced by id from inline `$` mentions in a
// note's rich content and from "person" note properties (template
// Owner/Attendees fields), so a person exists once and renaming the row updates
// every reference. Mention edges are persisted as NoteLink rows with
// kind "person" and targetLabel = the person id.
model Person {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@index([userId, name])
  @@map("people")
}

// Per-user note-tag metadata. Tag membership stays derived from note content
// (NoteLink rows with kind "tag"); a row exists here only once a user assigns
// a color, so listTags LEFT-JOINs this onto the derived counts.
model NoteTagMeta {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@map("note_tags")
}

// ─── Journal ─────────────────────────────────────────────────────────────────

model JournalEntry {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @map("user_id")
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateKey           String        @map("date_key")
  title             String?
  content           String
  richContent       Json?         @map("rich_content")
  mood              String?
  tags              String[]      @default([])
  calendarSourceId  String?       @map("calendar_source_id")
  calendarSourceUid String?       @map("calendar_source_uid")
  outgoingLinks     JournalLink[] @relation("JournalOutgoingLinks")
  deletedAt         DateTime?     @map("deleted_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  // Active date uniqueness is enforced by a Postgres partial unique index in
  // migrations because Prisma cannot model `WHERE deleted_at IS NULL`.
  @@index([userId, dateKey, deletedAt])
  @@index([userId, deletedAt])
  @@index([userId, calendarSourceId, calendarSourceUid])
  @@map("journal_entries")
}

model JournalFeedToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String    @unique @map("token_hash")
  tokenPrefix String    @map("token_prefix")
  revokedAt   DateTime? @map("revoked_at")
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([userId, revokedAt, createdAt(sort: Desc)])
  @@map("journal_feed_tokens")
}

// A saved external ICS URL (Google secret address, iCloud share link) that the
// daily cron fetches and imports into the owner's journal. `mode` mirrors
// JournalImportMode: "skip" never touches existing entries, "update" reconciles
// by calendar UID.
model CalendarSubscription {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  url            String
  label          String
  mode           String    @default("skip")
  enabled        Boolean   @default(true)
  lastSyncAt     DateTime? @map("last_sync_at")
  lastSyncStatus String?   @map("last_sync_status")
  lastSyncError  String?   @map("last_sync_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([enabled, lastSyncAt])
  @@map("calendar_subscriptions")
}

// Journal counterpart of NoteLink: the tag/person/note-link edges extracted from
// a journal entry's body + rich content, rewritten on every journal save (see
// syncJournalLinks in journal/journal-link-sync.ts). Kept in a separate table
// from NoteLink because the source is a JournalEntry, not a Note. Graph/tag/
// people surfaces union both.
model JournalLink {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id")
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceJournalId String       @map("source_journal_id") @db.Uuid
  sourceJournal   JournalEntry @relation("JournalOutgoingLinks", fields: [sourceJournalId], references: [id], onDelete: Cascade)
  targetNoteId    String?      @map("target_note_id") @db.Uuid
  targetLabel     String       @map("target_label")
  kind            String
  createdAt       DateTime     @default(now()) @map("created_at")

  @@unique([sourceJournalId, kind, targetLabel])
  @@index([userId, sourceJournalId])
  @@index([userId, targetNoteId])
  @@map("journal_links")
}

model JournalTag {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  color      String
  usageCount Int       @default(0) @map("usage_count")
  lastUsedAt DateTime? @map("last_used_at")
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([userId, deletedAt])
  @@map("tags")
}

// Tasks are a first-class workspace record. A task may originate from a
// checklist block, but its metadata remains useful after the source note moves.
model Task {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  status        String   @default("todo")
  priority      String   @default("medium")
  dueDate       String?  @map("due_date")
  tags          String[] @default([])
  assigneeIds   String[] @default([]) @map("assignee_ids")
  description   String   @default("")
  sourceNoteId  String?  @map("source_note_id") @db.Uuid
  sourceBlockId String?  @map("source_block_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([userId, sourceNoteId, sourceBlockId])
  @@index([userId, status, dueDate])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("tasks")
}

// ─── Recents ─────────────────────────────────────────────────────────────────

model UserRecent {
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId     String   @map("item_id")
  itemType   String   @map("item_type")
  accessedAt DateTime @default(now()) @map("accessed_at")

  @@id([userId, itemId])
  @@index([userId, accessedAt(sort: Desc)])
  @@map("user_recents")
}

// ─── AI ──────────────────────────────────────────────────────────────────────

model AiProviderKey {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String    @default("google")
  label          String
  encryptedKey   String    @map("encrypted_key")
  keyPreview     String    @map("key_preview")
  keyFingerprint String    @map("key_fingerprint")
  status         String    @default("untested")
  lastTestedAt   DateTime? @map("last_tested_at")
  lastUsedAt     DateTime? @map("last_used_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([userId, provider, keyFingerprint])
  @@index([userId, provider, createdAt(sort: Desc)])
  @@map("ai_provider_keys")
}

// ─── STORAGE ─────────────────────────────────────────────────────────────────

model UserStorageConfig {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String // "vercel-blob" | "s3"
  encryptedConfig String    @map("encrypted_config")
  configPreview   String    @map("config_preview")
  status          String    @default("untested")
  lastTestedAt    DateTime? @map("last_tested_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("user_storage_configs")
}

model AiUsageLog {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String?  @map("user_id")
  user                  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider              String
  model                 String?
  action                String
  humanAction           String?  @map("human_action")
  resourceType          String?  @map("resource_type")
  resourceId            String?  @map("resource_id")
  resourceUrl           String?  @map("resource_url")
  prompt                String?
  status                String
  errorMessage          String?  @map("error_message")
  inputTokens           Int?     @map("input_tokens")
  outputTokens          Int?     @map("output_tokens")
  totalTokens           Int?     @map("total_tokens")
  estimatedCost         Decimal? @map("estimated_cost") @db.Decimal(14, 8)
  estimatedCostCurrency String?  @map("estimated_cost_currency")
  estimatedCostEur      Decimal? @map("estimated_cost_eur") @db.Decimal(14, 8)
  keySource             String   @default("unknown") @map("key_source")
  metadata              Json     @default("{}")
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("ai_usage_logs")
}

model AiErrorEvent {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String?  @map("user_id")
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail         String?  @map("user_email")
  endpoint          String
  action            String?
  model             String?
  provider          String   @default("google")
  errorSource       String   @map("error_source")
  errorCode         String   @map("error_code")
  errorMessage      String   @map("error_message")
  httpStatus        Int?     @map("http_status")
  providerStatus    Int?     @map("provider_status")
  providerMessage   String?  @map("provider_message")
  contentLength     Int?     @map("content_length")
  hasUserApiKey     Boolean  @default(false) @map("has_user_api_key")
  apiKeyFingerprint String?  @map("api_key_fingerprint")
  userAgent         String?  @map("user_agent")
  requestContext    Json     @default("{}") @map("request_context")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([errorCode, createdAt(sort: Desc)])
  @@map("ai_error_events")
}

// ─── Seed Bundles ────────────────────────────────────────────────────────────

model SeedBundle {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @default("Default")
  folders   Json     @default("[]")
  notes     Json     @default("[]")
  tags      Json     @default("[]")
  journals  Json     @default("[]")
  isActive  Boolean  @default(false) @map("is_active")
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("seed_bundles")
}

// ─── Collaboration ───────────────────────────────────────────────────────────

model CollaborationRequest {
  id          String    @id @default(uuid()) @db.Uuid
  noteId      String    @map("note_id") @db.Uuid
  note        Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  requesterId String    @map("requester_id")
  requester   User      @relation("SentCollabRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  ownerId     String    @map("owner_id")
  owner       User      @relation("ReceivedCollabRequests", fields: [ownerId], references: [id], onDelete: Cascade)
  status      String    @default("pending")
  message     String?
  createdAt   DateTime  @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")

  @@unique([noteId, requesterId])
  @@index([ownerId, status])
  @@index([requesterId, status])
  @@map("collaboration_requests")
}

model NoteCollaborator {
  id         String   @id @default(uuid()) @db.Uuid
  noteId     String   @map("note_id") @db.Uuid
  note       Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation("NoteCollaborations", fields: [userId], references: [id], onDelete: Cascade)
  permission String   @default("viewer")
  invitedBy  String   @map("invited_by")
  inviter    User     @relation("SentCollaborations", fields: [invitedBy], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([noteId, userId])
  @@index([userId])
  @@map("note_collaborators")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  payload   Json     @default("{}")
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, read, createdAt(sort: Desc)])
  @@map("notifications")
}

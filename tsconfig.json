{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"types": ["node", "bun"],
		"paths": {
			"@/*": ["./apps/web/src/*"]
		}
	},
	"include": ["scripts/**/*.ts", "party/**/*.ts", "prisma.config.ts"],
	"exclude": ["node_modules", "apps", "packages", "generated"]
}
